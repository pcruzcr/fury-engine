# Normalize line endings: golden fixtures and generated sources must be byte-identical
# on Windows, Linux and macOS (determinism gates compare them).
* text=auto eol=lf
*.sln text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.glb binary
*.gltf text
*.fmt binary
*.fmt1 binary
*.fmt2 binary
*.fry binary
*.docx binary
*.pck binary
