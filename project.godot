; Engine configuration file.
; Fury Engine — Dual Fury tech foundation.
; Target: Godot 4.7.2-stable Mono (.NET 9), desktop-first, mobile-ready.

config_version=5

[application]

config/name="Dual Fury"
config/version="1.0.0-f0"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://scenes/boot/boot.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[dotnet]

project/assembly_name="Fury.Game"
